<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Onboarding Icon Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="40dp"
            app:cardCornerRadius="45dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#1E293B"
            app:strokeWidth="2dp"
            app:strokeColor="#2563EB">

            <ImageView
                android:id="@+id/iv_onboarding_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#38BDF8"
                android:contentDescription="Page Icon" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_onboarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Terms &amp; Data Conditions"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_onboarding_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please read and accept our emergency data policy to continue"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Detailed Content Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#1E293B">

            <TextView
                android:id="@+id/tv_onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:text="1. Data Collection: Medical ID, emergency contacts, GPS location, and accelerometer sensor data.\n\n2. Emergency Dispatch: Automatically sends SMS warnings &amp; hospital pre-alerts during crash/SOS events.\n\n3. Local Storage: Information remains saved locally on your device in an offline database." />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
