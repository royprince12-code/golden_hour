<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Onboarding Graphic Icon Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_onboarding_icon_bg"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1E293B"
            app:strokeWidth="3dp"
            app:strokeColor="#2563EB">

            <ImageView
                android:id="@+id/iv_onboarding_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_terms_shield"
                android:contentDescription="Page Icon" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_onboarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Terms &amp; Privacy Policy"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_onboarding_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please review the data &amp; safety terms before proceeding"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Detailed Content Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E293B"
            app:strokeWidth="1dp"
            app:strokeColor="#334155">

            <TextView
                android:id="@+id/tv_onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:text="1. Local Storage First: Your Medical ID and Emergency Contacts are stored offline in an encrypted SQLite database on your phone.\n\n2. Emergency Use Only: Live location &amp; Medical ID are shared exclusively during critical crash/SOS events.\n\n3. Zero Ad Tracking: Your emergency data is never sold or shared with third-party ad networks." />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
