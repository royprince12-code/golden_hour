<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bystander Accident Report"
            android:textColor="@color/input_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Report a road accident witnessed nearby. Location and photo details are dispatched to nearest ambulance and emergency dashboard."
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/input_border"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Accident Location / Landmark"
                    style="@style/Widget.GoldenHour.TextInputLayout"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_bystander_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vehicles Involved / Description"
                    style="@style/Widget.GoldenHour.TextInputLayout"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_bystander_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Camera Capture Section -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_capture_photo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Take Accident Photo (Camera)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/primary_accent"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp" />

                <ImageView
                    android:id="@+id/iv_accident_photo"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#E2E8F0"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Accident Evidence Photo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Severity Level"
                    android:textColor="@color/input_text"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_severity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/rb_minor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/input_text"
                        android:text="Minor" />

                    <RadioButton
                        android:id="@+id/rb_critical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:textColor="@color/emergency_accent"
                        android:textStyle="bold"
                        android:text="Critical (ICU)" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_bystander"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="SUBMIT REPORT &amp; DISPATCH"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/emergency_accent"
                    android:textColor="@color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
