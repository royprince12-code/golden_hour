<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B91C1C"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#FFFFFF"
            android:contentDescription="Crash Warning" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="POSSIBLE CRASH DETECTED"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Are you OK? Alert dispatching in..."
            android:textColor="#FEE2E2"
            android:textSize="14sp" />

        <!-- Countdown Display -->
        <TextView
            android:id="@+id/tv_countdown_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="10"
            android:textColor="#FFFFFF"
            android:textSize="80sp"
            android:textStyle="bold" />

        <!-- Responsiveness & Lock Screen Medical ID Summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#7F1D1D"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_lockscreen_medical_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lock Screen Medical ID: Blood Group -- | Allergies: None"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Visible to first responders on Lock Screen without unlocking device."
                    android:textColor="#FECACA"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cancel / OK Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_countdown"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="I AM OK - CANCEL ALERT"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            android:textColor="#B91C1C"
            app:cornerRadius="30dp"
            android:layout_marginBottom="12dp" />

        <!-- Instant Help Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_help_now"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="SEND HELP IMMEDIATELY"
            android:textSize="14sp"
            app:backgroundTint="#7F1D1D"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp" />

    </LinearLayout>

</RelativeLayout>
