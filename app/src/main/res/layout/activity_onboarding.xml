<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- ViewPager for Full Screen Onboarding Pages -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_onboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_onboarding_bottom" />

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layout_onboarding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Custom Page Indicator Dots Row -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/dot_0"
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_active"
                android:layout_margin="4dp" />

            <View
                android:id="@+id/dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_inactive"
                android:layout_margin="4dp" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_inactive"
                android:layout_margin="4dp" />
        </LinearLayout>

        <!-- Next / Agree / Get Started Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="AGREE &amp; CONTINUE"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>
